        "custom_liquid": "<style>/* MAGNIFIO Autumn 2026 — premium overrides */\n.card-wrapper,.card-wrapper:hover{transform:none!important;box-shadow:none!important}\n.card__media{background:#f3ebe1!important}\n.card__media img{object-position:center 15%!important;transition:opacity .6s ease,transform 1.2s cubic-bezier(.2,.7,.2,1)!important}\n.card-wrapper:hover .card__media img{transform:scale(1.035)!important}\n.card__content{padding:12px 2px 6px!important}\n.card__heading,.card__heading a{font-size:12px!important;letter-spacing:.1em!important;line-height:1.35!important;font-family:var(--font-body-family)!important}\n.card-information .price,.card .price{font-size:13px!important}\n.collection .grid,.product-grid{column-gap:clamp(8px,1vw,16px)!important;row-gap:clamp(18px,2vw,32px)!important}\n/* trust bar: calm single row */\n.mf-trust{background:#fdfaf5!important;border:0!important;border-top:1px solid rgba(26,21,18,.08)!important;border-bottom:1px solid rgba(26,21,18,.08)!important}\n.mf-trust__inner{max-width:1400px!important;padding:22px clamp(16px,3vw,40px)!important;gap:0!important;justify-content:space-between!important}\n.mf-trust__item{background:none!important;border:0!important;box-shadow:none!important;padding:0 12px!important;flex-direction:row!important;gap:10px!important}\n.mf-trust__item:hover{transform:none!important}\n.mf-trust__item::before{display:none!important}\n.mf-trust__svg{width:20px!important;height:20px!important}\n.mf-trust__item span{font-size:11px!important;letter-spacing:.2em!important}\n@media(max-width:749px){.mf-trust__inner{display:grid!important;grid-template-columns:1fr 1fr;row-gap:14px!important}.mf-trust__item{justify-content:flex-start!important}.mf-trust__item span{font-size:10px!important}}\n/* product page */\n.product__title h1,.product__title{font-size:clamp(20px,2vw,26px)!important;letter-spacing:.08em!important}\n.product-form__input--dropdown .select__select{border-radius:0!important;font-size:13px;letter-spacing:.06em;min-height:48px}\n.product-form__input input[type=radio]+label{border-radius:0!important;min-width:56px;padding:10px 14px!important;font-size:12px!important;letter-spacing:.1em;border:1px solid rgba(26,21,18,.18)!important;background:transparent!important;color:#1a1512!important;margin:0 6px 8px 0!important}\n.product-form__input input[type=radio]:checked+label{background:#1a1512!important;color:#fdfaf5!important;border-color:#1a1512!important}\n.product-form__submit{background:#1a1512!important;color:#fdfaf5!important;border:0!important;min-height:54px}\n.product-form__submit:hover{background:#c17a54!important}\n.product__media-item img{object-fit:cover!important}\n.mf-desc{font-size:14px;line-height:1.75;color:#1a1512}.mf-desc p{opacity:1!important;font-size:14px!important}.mf-desc .mf-lead{font-size:16px!important;line-height:1.65;margin:0 0 6px}.mf-desc h3{font-family:var(--font-body-family);font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;margin:26px 0 10px}.mf-list{list-style:none;padding:0;margin:0}.mf-list li{padding:8px 0;border-bottom:1px solid rgba(26,21,18,.08)}.mf-list strong{font-weight:600}.mf-size{width:100%;border-collapse:collapse;font-size:13px;margin:4px 0 0}.mf-size th,.mf-size td{padding:10px 8px;text-align:center;border-bottom:1px solid rgba(26,21,18,.1)}.mf-size th:first-child,.mf-size td:first-child{text-align:left}.mf-size thead th{background:#f3ebe1;font-weight:600;font-size:12px;letter-spacing:.06em}.mf-sizenote{font-size:12px;opacity:.65;margin:8px 0 0}</style>",
